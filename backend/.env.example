# Stellar AI - Backend Environment Variables
# Copy this to .env and fill in your values

# Google Gemini — Developer API (AI Studio / GCP "Gemini API")
# Primary key (required for backend vision unless GEMINI_BACKEND=vertex)
GEMINI_API_KEY=
# Optional: route Gemini developer API through Singapore/Japan (or any) egress — no Modal change required.
# When set, backend uses REST transport so urllib3 honors the proxy.
# GEMINI_HTTPS_PROXY=http://127.0.0.1:7890
# GEMINI_HTTP_PROXY=http://127.0.0.1:7890
# Optional extra keys — same format; on quota/429 backend tries GEMINI_API_KEY_2 … _10
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# Model id for google-generativeai (see Google docs for your key tier)
# GEMINI_MODEL=gemini-2.5-flash-lite
# Vertex AI instead of API key (requires GCP ADC / service account — not AIza keys)
# GEMINI_BACKEND=vertex
# GOOGLE_CLOUD_PROJECT=
# VERTEX_AI_LOCATION=us-central1
# Singapore / Tokyo Vertex regions (when using GEMINI_BACKEND=vertex):
# VERTEX_AI_LOCATION=asia-southeast1
# VERTEX_AI_LOCATION=asia-northeast1
# VERTEX_GEMINI_MODEL=gemini-2.0-flash-001

# Cloudflare R2 Storage
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=stellar-golf-media

# JWT Secret (must match frontend)
JWT_SECRET=your-secret-key-change-this-in-production

# Frontend URL (for CORS)
FRONTEND_URL=https://your-app.pages.dev

# Golf News API Key (optional - falls back to mock data)
# Get from https://sportsdata.io or RapidAPI
GOLF_NEWS_API_KEY=

# Alibaba Cloud Qwen API Key — used for CN region (qwen3-vl-235b-a22b)
# Get from https://dashscope.console.aliyun.com/
QWEN_API_KEY=

# ── Posture Practice Video Generation ─────────────────────────────────────────
# Replicate (primary provider) — get token from https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Override default model (minimax/video-01); other options:
#   wavespeedai/wan-2.1-t2v-720p  bytedance/seedance-1-lite  xai/grok-imagine-video
# REPLICATE_VIDEO_MODEL=minimax/video-01

# Gemini Veo (fallback when Replicate unavailable or 429)
# Reuses GEMINI_API_KEY above — no extra key needed.
# Override Veo model: GEMINI_API_KEY must have video generation quota enabled.
# VEO_MODEL=veo-3.1-generate-preview
# Veo-specific keys (optional, keeps video quota separate from vision quota):
# VEO_API_KEY=
# VEO_API_KEY_2=

# ── MMAction2 (optional video action prior for phase segmentation) ───────────
# Install stack: see backend/requirements-mmaction2.txt or scripts/setup_mmaction_conda.sh
# Modal: `modal deploy` bakes MMAction2 via tools/modal_install_mmaction2.sh — no extra env unless you set STELLAR_ACTION_BACKEND=disabled.
# After conda env: scripts/setup_mmaction_conda.sh (patches incomplete PyPI wheel via scripts/ensure_mmaction2_runtime.sh)
# Download Kinetics TSN weights (run from backend/):
#   .conda-mmaction/envs/stellar-mmaction/bin/mim download mmaction2 \
#     --config tsn_imagenet-pretrained-r50_8xb32-1x1x8-100e_kinetics400-rgb --dest mmaction_models
# Paths are relative to the process cwd (use absolute paths in production if needed).
STELLAR_ACTION_BACKEND=mmaction2
STELLAR_MMACTION2_CONFIG=mmaction_models/tsn_imagenet-pretrained-r50_8xb32-1x1x8-100e_kinetics400-rgb.py
STELLAR_MMACTION2_CHECKPOINT=mmaction_models/tsn_imagenet-pretrained-r50_8xb32-1x1x8-100e_kinetics400-rgb_20220906-2692d16c.pth
STELLAR_MMACTION2_DEVICE=cpu
# STELLAR_MMACTION2_SLIDING_WINDOWS=3
# Turn off without removing paths:
# STELLAR_ACTION_BACKEND=disabled

# ── RTMPose / MMPose (optional pose backend) ──────────────────────────────────
# Requires: pip install mmpose mmcv mmengine mmdet (see backend/requirements-mmpose.txt + install_mmpose_fast.sh).
# Defaults are built in: bundled COCO rtmpose-m config from the mmpose package + OpenMMLab weight URL
# (first run downloads ~tens of MB to torch hub cache). Override only if you need another model:
# STELLAR_POSE_BACKEND=rtmpose
# STELLAR_RTMPOSE_CONFIG=
# STELLAR_RTMPOSE_CHECKPOINT=
# STELLAR_RTMPOSE_DEVICE=cpu
# STELLAR_RTMPOSE_DET_MODEL=whole_image

# ── Pro v3 video preprocessing (240fps MCI + cleanup) ─────────────────────────
# No system apt/ffmpeg required: default uses PATH if present, else pip package ``imageio-ffmpeg``
# (bundled static ffmpeg in the venv). Phones only upload MP4; processing is server-side.
# STELLAR_FFMPEG_BINARY=/absolute/path/ffmpeg
# STELLAR_FFPROBE_BINARY=/absolute/path/ffprobe   # optional; if absent, OpenCV reads width/fps/duration

# ── Pro v3 A = wmcnally/golfdb SwingNet (B refines same run) ─────────────────
# Code: backend/lib/golfdb_swingnet + services/golfdb_swingnet_service.py
# Upstream repo + license (CC BY-NC 4.0): https://github.com/wmcnally/golfdb
#
# **Weights (required for real SwingNet — not in git):**
#   cd backend && .venv/bin/pip install -r requirements-golfdb-swingnet.txt
#   bash scripts/download_golfdb_swingnet_weights.sh
#   → writes models/swingnet_1800.pth.tar (auto-detected; see env.prov3.swingnet.example)
# Manual: Google Drive id 1MBIDwHSM8OKRbxS8YfyRLnUBAdt0nupW — link in GolfDB README “Evaluate”.
#
# Resolution order: (1) STELLAR_SWINGNET_CHECKPOINT if file exists
#                   (2) /models/swingnet_*.pth* (Modal volume overrides image bake)
#                   (3) /opt/stellar-weights/swingnet_*.pth* (Modal image bake)
#                   (4) backend/models/…
# STELLAR_SWINGNET_CHECKPOINT=/absolute/path/swingnet_1800.pth.tar
# STELLAR_SWINGNET_DEVICE=cpu
# STELLAR_SWINGNET_SEQ_LEN=64
# Non-Modal: auto-download weights on first SwingNet load (default on). Set 0 to require manual file.
# STELLAR_SWINGNET_AUTO_DOWNLOAD=1
# If no weights resolve, Pro v3 A uses heuristics only (B has no SwingNet prob ctx).

# ── DeepLabCut (optional research refine; non-blocking in Plus pipeline) ─────
# Install: backend/scripts/install_deeplabcut.sh  or  pip install -r requirements-deeplabcut.txt
# Bootstrap project: python scripts/bootstrap_deeplabcut_workspace.py  (writes deeplabcut_workspace/.stellar_dlc_config)
# Train a snapshot before enabling — otherwise analyze_videos fails each call.
# STELLAR_RESEARCH_BACKEND=deeplabcut
# STELLAR_DLC_PROJECT_CONFIG=   # optional override; default = deeplabcut_workspace/.stellar_dlc_config
# STELLAR_DLC_OUTPUT_DIR=     # optional; default deeplabcut_workspace/outputs
