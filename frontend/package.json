{
  "name": "stellar-ai",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/fetch-mediapipe-models.mjs && NODE_OPTIONS='--require ./scripts/next-edge-build-polyfill.cjs' next build",
    "start": "next start",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:plus-gemini-visibility": "node components/__tests__/plus-gemini-visibility.mjs",
    "test:smoke": "node ../tools/analysis-smoke.mjs",
    "test:history-sync": "node ../tools/verify-history-sync.mjs",
    "pages:build": "node scripts/fetch-mediapipe-models.mjs && NODE_OPTIONS='--require ./scripts/next-edge-build-polyfill.cjs' npx @cloudflare/next-on-pages && rm -f .vercel/output/static/_worker.js/nop-build-log.json",
    "pages:deploy": "wrangler pages deploy .vercel/output/static --commit-dirty=true",
    "pages:deploy:debug": "WRANGLER_LOG=debug wrangler pages deploy .vercel/output/static --commit-dirty=true"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@mediapipe/tasks-vision": "^0.10.33",
    "aws4fetch": "^1.0.20",
    "jose": "^5.9.6",
    "jsonwebtoken": "^9.0.2",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.7",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/estree": "^1.0.8",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
