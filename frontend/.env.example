# Stellar AI - Frontend Environment Variables
# Copy this to .env.local and fill in your values
#
# Policy: backend / storage / upstream media origins must NOT use NEXT_PUBLIC_* — those are inlined
# into the browser bundle. The browser only calls same-origin /api/* and /api/cdn/p for media.

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: GEMINI_API_KEY_2 … GEMINI_API_KEY_10 (same format; quota / multi-key failover on Edge)
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Cloudflare Account Settings
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=stellar-golf-media
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=

# Backend API URL for Edge routes (e.g. /api/news). Server-only — not exposed in the client bundle.
BACKEND_URL=https://your-app.onrender.com

# Frontend App URL (Cloudflare Pages URL) — safe to be public
NEXT_PUBLIC_APP_URL=https://your-app.pages.dev

# Optional: MediaPipe mirror on R2 (no trailing slash). Edge-only: /api/mp-assets, /api/mp-model.
# MEDIAPIPE_CDN_BASE=https://pub-xxxxx.r2.dev/static/mediapipe/tasks-vision/0.10.33

# Optional (Edge only): public R2 origin for /api/cdn/p when result JSON has path-only /prov3-media/…
# STELLAR_PROV3_R2_PUBLIC_BASE=https://pub-xxxx.r2.dev

# JWT Secret (must match backend)
JWT_SECRET=your-secret-key-change-this-in-production
